    <div class="code-tab-panel active" data-tab="json">
      <pre><code class="language-rust">use xstate_statemachine::prelude::*;

fn main() -&gt; Result&lt;(), Box&lt;dyn std::error::Error&gt;&gt; {
    // 1. Load an XState v5 / Stately JSON chart
    let machine = Machine::from_json(r#"{
        "id": "trafficLight",
        "initial": "green",
        "states": {
            "green":  { "on": { "TIMER": "yellow" } },
            "yellow": { "on": { "TIMER": "red" } },
            "red":    { "on": { "TIMER": "green" } }
        }
    }"#)?;

    // 2. Attach dynamic Rust closures for guards and actions
    let logic = MachineLogic::dynamic()
        .action("logChange", |scope| {
            println!("State changed: {:?}", scope.active_state_ids);
            Ok(())
        });

    // 3. Drive with zero-allocation interpreter (69.8 ns send_fast)
    let mut interp = SyncInterpreter::new(machine, logic);
    interp.start()?;
    interp.send("TIMER")?;
    assert_eq!(interp.active_state_ids(), ["trafficLight.yellow"]);
    Ok(())
}</code></pre>
    </div>

    <div class="code-tab-panel" data-tab="macros">
      <pre><code class="language-rust">use xstate_statemachine::prelude::*;
use xstate_statemachine::macros::statechart;

statechart! {
    name: TrafficLight;
    initial: Green;
    states: {
        Green {
            on: {
                Timer =&gt; Yellow,
            }
        }
        Yellow {
            on: {
                Timer =&gt; Red,
            }
        }
        Red {
            on: {
                Timer =&gt; Green,
            }
        }
    }
}

fn main() -&gt; Result&lt;(), Box&lt;dyn std::error::Error&gt;&gt; {
    let mut actor = TrafficLight::new();
    actor.start()?;
    actor.send(TrafficLightEvent::Timer)?;
    assert_eq!(actor.state(), TrafficLightState::Yellow);
    Ok(())
}</code></pre>
    </div>

    <div class="code-tab-panel" data-tab="tokio">
      <pre><code class="language-rust">use xstate_statemachine::prelude::*;
use xstate_statemachine::tokio::{ActorOptions, OverflowPolicy};
use std::time::Duration;

#[tokio::main]
async fn main() -&gt; Result&lt;(), Box&lt;dyn std::error::Error&gt;&gt; {
    let machine = Machine::from_json(include_str!("../tests/fixtures/order.json"))?;
    let logic = MachineLogic::dynamic();

    // Spawn concurrent actor with bounded mailbox and backpressure
    let actor = xstate_statemachine::tokio::spawn(
        machine,
        logic,
        ActorOptions::default()
            .with_capacity(1024)
            .with_overflow(OverflowPolicy::Block),
    ).await?;

    // Send and wait for transition receipt
    let receipt = actor.send_and_wait("SUBMIT", Duration::from_secs(5)).await?;
    assert_eq!(receipt.state_ids(), ["order.submitted"]);

    actor.stop().await?;
    Ok(())
}</code></pre>
    </div>

    <div class="code-tab-panel" data-tab="saga">
      <pre><code class="language-rust">use xstate_statemachine::patterns::saga::{Saga, SagaStep, SagaStatus};

#[tokio::main]
async fn main() -&gt; Result&lt;(), Box&lt;dyn std::error::Error&gt;&gt; {
    let saga = Saga::builder("ecommerce-checkout")
        .step(
            SagaStep::new("reserve_inventory")
                .action(|ctx| async move { inventory::reserve().await })
                .compensation(|ctx| async move { inventory::release().await }),
        )
        .step(
            SagaStep::new("charge_payment")
                .action(|ctx| async move { payment::charge().await })
                .compensation(|ctx| async move { payment::refund().await }),
        )
        .build();

    let outcome = saga.execute(context).await?;
    assert_eq!(outcome.status, SagaStatus::Completed);
    Ok(())
}</code></pre>
