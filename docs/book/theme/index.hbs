<!DOCTYPE HTML>
<html lang="{{ language }}" class="dark" data-theme="dark" dir="{{ text_direction }}">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    {{#if is_print }}
    <meta name="robots" content="noindex">
    {{/if}}
    {{#if base_url}}
    <base href="{{ base_url }}">
    {{/if}}

    <!-- Custom HTML head (Fonts, favicons, theme script) -->
