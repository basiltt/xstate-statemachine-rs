<!-- Theme initialization (dark by default) -->
<script>
  (function() {
    var theme = null;
    try {
      theme = localStorage.getItem('theme') || localStorage.getItem('mdbook-theme');
    } catch (_) {}
    if (!theme || theme === 'navy' || theme === 'coal' || theme === 'ayu' || theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
      document.documentElement.classList.remove('dark');
    }
  })();
</script>
