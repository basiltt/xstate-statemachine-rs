@startuml
hide empty description
state "m" as m {
  [*] --> m_p
  state "p" as m_p {
    state "r1" as m_p_r1 {
      [*] --> m_p_r1_a
      state "a" as m_p_r1_a
      state "b" as m_p_r1_b
    }
    --
    state "r2" as m_p_r2 {
      [*] --> m_p_r2_c
      state "c" as m_p_r2_c
    }
    --
    state "r3" as m_p_r3 {
      [*] --> m_p_r3_d
      state "d" as m_p_r3_d
      state "f" as m_p_r3_f
    }
  }
  state "out" as m_out
}
[*] --> m_p
m_p --> m_out : E
m_p_r1_a --> m_p_r1_b : E
m_p_r3_d --> m_p_r3_f : E
@enduml