@startuml
hide empty description
state "m" as m {
  [*] --> m_a
  state "a" as m_a {
    [*] --> m_a_a1
    state "a1" as m_a_a1 {
      [*] --> m_a_a1_a1x
      state "a1x" as m_a_a1_a1x
      state "a1y" as m_a_a1_a1y
    }
  }
  state "b" as m_b {
    [*] --> m_b_b1
    state "b1" as m_b_b1
    state "b2" as m_b_b2
  }
}
[*] --> m_a
m_a --> m_b : RESET
m_a_a1_a1x --> m_a_a1_a1y : NEXT
m_a_a1_a1y --> m_b_b2 : JUMP
m_b_b2 --> m_a : BACK
@enduml