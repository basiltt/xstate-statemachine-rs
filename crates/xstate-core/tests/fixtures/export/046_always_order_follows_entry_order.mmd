stateDiagram-v2
[*] --> m
state "m" as m {
    [*] --> p
    state "p" as p {
        state "r1" as r1 {
            [*] --> a
            state "a" as a
            state "b" as b
        }
        --
        state "r2" as r2 {
            [*] --> c
            state "c" as c
            state "d" as d
        }
    }
    state "x" as x
    state "y" as y
}
m --> p : RESET
a --> b : E
b --> x : always [and]
c --> d : F
d --> y : always [and]