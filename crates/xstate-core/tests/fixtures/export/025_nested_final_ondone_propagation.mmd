stateDiagram-v2
[*] --> m
state "m" as m {
    [*] --> outer
    state "outer" as outer {
        [*] --> inner
        state "inner" as inner {
            [*] --> s
            state "s" as s
            state "f" as f
            f --> [*]
        }
        state "next" as next
        state "fin" as fin
        fin --> [*]
    }
    state "complete" as complete
    complete --> [*]
}
outer --> complete : onDone
inner --> next : onDone
s --> f : X
next --> fin : Y