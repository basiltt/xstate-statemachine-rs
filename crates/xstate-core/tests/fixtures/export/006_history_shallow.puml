@startuml
hide empty description
state "wizard" as wizard {
  [*] --> wizard_form
  state "form" as wizard_form {
    [*] --> wizard_form_name
    state "name" as wizard_form_name
    state "address" as wizard_form_address {
      [*] --> wizard_form_address_street
      state "street" as wizard_form_address_street
      state "city" as wizard_form_address_city
    }
    state "resume" as wizard_form_resume
  }
  state "help" as wizard_help
}
[*] --> wizard_form
wizard_form --> wizard_help : ASK
wizard_form_name --> wizard_form_address : NEXT
wizard_form_address_street --> wizard_form_address_city : NEXT
wizard_help --> wizard_form_resume : BACK
@enduml