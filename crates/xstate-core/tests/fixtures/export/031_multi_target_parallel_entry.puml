@startuml
hide empty description
state "m" as m {
  [*] --> m_idle
  state "idle" as m_idle
  state "p" as m_p {
    state "r1" as m_p_r1 {
      [*] --> m_p_r1_a
      state "a" as m_p_r1_a
      state "x" as m_p_r1_x
    }
    --
    state "r2" as m_p_r2 {
      [*] --> m_p_r2_c
      state "c" as m_p_r2_c
      state "y" as m_p_r2_y
    }
  }
}
[*] --> m_idle
m_idle --> m_p_r1_x : GO
@enduml