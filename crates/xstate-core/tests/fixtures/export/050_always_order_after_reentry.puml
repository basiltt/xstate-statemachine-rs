@startuml
hide empty description
state "m" as m {
  [*] --> m_p
  state "p" as m_p {
    state "r1" as m_p_r1 {
      [*] --> m_p_r1_s
      state "s" as m_p_r1_s {
        [*] --> m_p_r1_s_s1
        state "h" as m_p_r1_s_h
        state "s1" as m_p_r1_s_s1
      }
    }
    --
    state "r2" as m_p_r2 {
      [*] --> m_p_r2_t
      state "t" as m_p_r2_t {
        [*] --> m_p_r2_t_t1
        state "t1" as m_p_r2_t_t1
      }
    }
    --
    state "r3" as m_p_r3 {
      [*] --> m_p_r3_idle
      state "idle" as m_p_r3_idle
      state "armed" as m_p_r3_armed
    }
  }
  state "x" as m_x
  state "y" as m_y
}
[*] --> m_p
m_p_r1_s --> m_p_r1_s : RS
m_p_r1_s_s1 --> m_x : always [and]
m_p_r2_t --> m_p_r2_t : RT
m_p_r2_t_t1 --> m_y : always [and]
m_p_r3_idle --> m_p_r3_armed : ARM
m_x --> m_p : BACK
m_y --> m_p : BACK
@enduml