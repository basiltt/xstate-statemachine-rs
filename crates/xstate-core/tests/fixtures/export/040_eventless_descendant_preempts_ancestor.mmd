stateDiagram-v2
[*] --> m
state "m" as m {
    [*] --> p
    state "p" as p {
        state "r1" as r1 {
            [*] --> a
            state "a" as a
        }
        --
        state "r2" as r2 {
            [*] --> b
            state "b" as b
            state "c" as c
            state "d" as d
        }
    }
    state "out" as out
}
p --> out : always [stateIn]
b --> c : GO
c --> d : always