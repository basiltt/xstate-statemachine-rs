"""Type stubs for the native ``xstate_rs`` extension module (re-exported by the package)."""

from typing import Any, Callable, Dict, FrozenSet, List, Literal, Mapping, Optional, Set, Union, final

_EventDict = Dict[str, Any]
_Status = Literal["uninitialized", "running", "done", "error", "stopped"]
_RestartTimers = Union[Literal["resume", "parked", "fire_due", "restart"], bool, None]

_ActionFn = Callable[[Dict[str, Any], _EventDict, Any], Optional[Dict[str, Any]]]
_GuardFn = Callable[[Dict[str, Any], _EventDict, Any], bool]
_ServiceFn = Callable[[Dict[str, Any], Any], Any]
_DelayFn = Callable[[Dict[str, Any], _EventDict], Union[int, float]]
_ObserverFn = Callable[[_EventDict, List[str], bool], None]

SNAPSHOT_VERSION: int
__version__: str

def structure_hash(machine: Machine) -> str:
    """16 hex characters, identical to ``xstate_statemachine.persistence.structure_hash``."""

class XStateError(Exception):
    """Base class of every engine error. ``kind`` is the stable error kind name."""

    kind: str

class ConfigError(XStateError): ...
class StateNotFoundError(ConfigError): ...
class ImplementationMissingError(ConfigError): ...
class InvalidEventError(XStateError): ...
class UnknownEventError(XStateError): ...
class InvalidLifecycleError(XStateError): ...
class LogicError(XStateError): ...
class TransitionFailedError(LogicError): ...
class RunawayChainError(LogicError): ...
class SnapshotError(XStateError): ...
class LimitExceededError(XStateError): ...

@final
class Machine:
    """A compiled, immutable statechart."""

    @staticmethod
    def from_json(text: str) -> Machine: ...
    @staticmethod
    def from_dict(config: Dict[str, Any]) -> Machine: ...
    @property
    def id(self) -> str: ...
    @property
    def version(self) -> Optional[str]: ...
    @property
    def structure_hash(self) -> str: ...
    @property
    def declared_events(self) -> List[str]: ...
    @property
    def state_ids(self) -> List[str]: ...
    def to_json(self) -> str: ...
    def to_dict(self) -> Dict[str, Any]: ...
    def to_mermaid(self) -> str: ...
    def to_plantuml(self) -> str: ...
    def validate(self, logic: Optional[MachineLogic] = None) -> List[str]: ...

@final
class MachineLogic:
    """Python implementations of the names a machine refers to.

    * action ``fn(context, event, params) -> None | dict``: ``context`` is a fresh copy per
      call; mutations to it are written back, and a returned dict is merged in as a patch.
    * guard ``fn(context, event, params) -> bool``.
    * service ``fn(context, input) -> result`` (synchronous); raising fails the invocation.
    * delay: milliseconds, or ``fn(context, event) -> ms``.
    """

    def __new__(
        cls,
        actions: Optional[Mapping[str, _ActionFn]] = None,
        guards: Optional[Mapping[str, _GuardFn]] = None,
        services: Optional[Mapping[str, _ServiceFn]] = None,
        delays: Optional[Mapping[str, Union[int, float, _DelayFn]]] = None,
    ) -> MachineLogic: ...
    @property
    def actions(self) -> Dict[str, _ActionFn]: ...
    @property
    def guards(self) -> Dict[str, _GuardFn]: ...
    @property
    def services(self) -> Dict[str, _ServiceFn]: ...
    @property
    def delays(self) -> Dict[str, Union[float, _DelayFn]]: ...

@final
class Receipt:
    """What processing one event (and everything it triggered) did."""

    @property
    def state_ids(self) -> FrozenSet[str]: ...
    @property
    def changed(self) -> bool: ...
    @property
    def unhandled(self) -> bool: ...
    @property
    def actions(self) -> List[str]: ...
    @property
    def status(self) -> _Status: ...
    @property
    def error(self) -> Optional[BaseException]: ...
    def matches(self, state_id: str) -> bool: ...

@final
class SimulatedClock:
    """Virtual time; ``increment`` fires due timers on every started interpreter using it."""

    def __new__(cls) -> SimulatedClock: ...
    @property
    def now_ms(self) -> float: ...
    def now(self) -> float: ...
    def increment(self, ms: float) -> None: ...
    def set(self, ms: float) -> None: ...

@final
class SyncInterpreter:
    """Runs a machine in the Rust engine; every call processes to completion."""

    def __new__(
        cls,
        machine: Machine,
        logic: Optional[MachineLogic] = None,
        *,
        clock: Optional[SimulatedClock] = None,
        input: Any = None,
    ) -> SyncInterpreter: ...
    @staticmethod
    def from_snapshot(
        machine: Machine,
        logic: Optional[MachineLogic],
        json_text: str,
        *,
        restart_timers: _RestartTimers = None,
        verify_hash: bool = True,
        clock: Optional[SimulatedClock] = None,
    ) -> SyncInterpreter: ...
    def start(self) -> Receipt: ...
    def send(self, event: Union[str, Mapping[str, Any], Any], /, **payload: Any) -> Receipt: ...
    def tick(self) -> Receipt: ...
    def advance(self, ms: float) -> Receipt: ...
    def stop(self) -> None: ...
    def observe(self, callback: _ObserverFn) -> None: ...
    def snapshot(self) -> str: ...
    def get_snapshot(self) -> str: ...
    def matches(self, state_id: str) -> bool: ...
    def take_emitted(self) -> List[Dict[str, Any]]: ...
    @property
    def status(self) -> _Status: ...
    @property
    def state_ids(self) -> List[str]: ...
    @property
    def current_state_ids(self) -> Set[str]: ...
    @property
    def value(self) -> Union[str, Dict[str, Any], None]: ...
    @property
    def context(self) -> Any: ...
    @property
    def output(self) -> Any: ...
    @property
    def error(self) -> Optional[str]: ...
    @property
    def machine(self) -> Machine: ...
    @property
    def id(self) -> str: ...
    @property
    def pending_timers(self) -> int: ...
