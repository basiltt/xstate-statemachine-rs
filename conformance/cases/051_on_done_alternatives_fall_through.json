        "initial": "work",
        "onDone": [
          {
            "target": "first",
            "guard": "isFirst",
            "actions": "tookFirst"
          },
          {
            "target": "second",
            "guard": "isSecond",
            "actions": "tookSecond"
          },
          {
            "target": "fallback",
            "actions": "tookFallback"
          }
        ],
        "states": {
          "work": {
            "on": {
              "FINISH": "finished"
            }
          },
          "finished": {
            "type": "final"
          }
        }
      },
      "first": {},
      "second": {},
      "fallback": {}
    }
  },
  "logic": {
