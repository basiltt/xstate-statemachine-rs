        "entry": "enterA",
        "always": {
          "target": "b",
          "actions": [
            {
              "type": "raise",
              "params": {
                "event": {
                  "type": "GO"
                }
              }
            },
            "alwaysRan"
          ]
        }
      },
      "b": {
        "entry": "enterB",
        "on": {
          "GO": {
            "target": "c",
            "actions": "go"
          },
          "BACK": "a"
        }
      },
      "c": {
        "entry": "enterC",
        "on": {
          "BACK": "a"
        }
      }
    }
  },
  "steps": [
