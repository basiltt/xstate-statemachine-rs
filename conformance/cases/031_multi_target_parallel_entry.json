{
  "name": "multi_target_parallel_entry",
  "description": "A transition with two targets, one per region, enters both specific children instead of the initial state of each region.",
  "tags": [
    "parallel",
    "multi-target"
  ],
  "machine": {
    "id": "m",
    "initial": "idle",
    "states": {
      "idle": {
        "on": {
          "GO": {
            "target": [
              "#m.p.r1.x",
              "#m.p.r2.y"
            ]
          }
        }
      },
      "p": {
        "type": "parallel",
        "states": {
          "r1": {
            "initial": "a",
            "states": {
              "a": {
                "entry": "e_a"
              },
              "x": {
                "entry": "e_x"
              }
            }
          },
          "r2": {
            "initial": "c",
            "states": {
              "c": {
                "entry": "e_c"
              },
              "y": {
                "entry": "e_y"
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "send": "GO"
    }
  ],
  "divergence": {
    "python": "Multi-target transitions (`target: [a, b]`) are rejected at build time.",
    "spec": "XState (and SCXML) allow several targets as long as they lie in different regions of one parallel state; both are entered instead of the regions' initial states.",
    "rust_follows": "xstate"
  },
  "expected": {
    "xstate": {
      "initial": {
        "state_ids": [
          "m.idle"
        ],
        "context": {},
        "actions": [],
        "status": "running"
      },
      "steps": [
        {
          "state_ids": [
            "m.p.r1.x",
            "m.p.r2.y"
          ],
          "context": {},
          "actions": [
            "e_x",
            "e_y"
          ],
          "status": "running"
        }
      ],
      "oracle": {
        "name": "xstate",
        "version": "5.33.3"
      }
    },
    "python": {
      "oracle": {
        "name": "xstate-statemachine",
        "version": "0.12.0"
      },
      "unsupported": "InvalidConfigError: Transition 'GO' on state 'm.idle': 'target' must be a string (multi-target lists are not supported), got list"
    }
  }
}
