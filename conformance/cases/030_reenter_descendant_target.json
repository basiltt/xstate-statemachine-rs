{
  "name": "reenter_descendant_target",
  "description": "Targeting a descendant without reenter leaves the source active (no exit/entry of the source); with reenter the source is exited and re-entered.",
  "tags": [
    "reenter",
    "hierarchy"
  ],
  "machine": {
    "id": "m",
    "initial": "p",
    "states": {
      "p": {
        "initial": "a",
        "entry": "e_p",
        "exit": "x_p",
        "on": {
          "SOFT": {
            "target": ".b",
            "actions": "soft"
          },
          "HARD": {
            "target": ".a",
            "reenter": true,
            "actions": "hard"
          }
        },
        "states": {
          "a": {
            "entry": "e_a",
            "exit": "x_a"
          },
          "b": {
            "entry": "e_b",
            "exit": "x_b"
          }
        }
      }
    }
  },
  "steps": [
    {
      "send": "SOFT"
    },
    {
      "send": "HARD"
    }
  ],
  "divergence": {
    "python": "`reenter` is honoured for self-targets only; a re-entering transition to a descendant exits just the previously active child.",
    "spec": "With `reenter: true` the domain is the least common ancestor above the source, so the source itself is exited and re-entered (x_p ... e_p) before the target child.",
    "rust_follows": "xstate"
  },
  "expected": {
